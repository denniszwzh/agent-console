{
  "name": "agent-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Local review panel for Claude Code and Codex CLI replies: ask about any passage in a read-only fork, then send the conclusions back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denniszwzh/agent-console.git"
  },
  "homepage": "https://github.com/denniszwzh/agent-console#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "selfsigned": "^5.5.0",
    "shiki": "^4.6.0",
    "unified": "^11.0.5"
  },
  "bin": {
    "agent-console": "dist/cli/main.js"
  }
}
